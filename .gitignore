# --- Tajné údaje (tokeny, hesla, IP adresy) ---
# Tenhle řádek je nejdůležitější v celém souboru.
# config.py obsahuje reálné tokeny -> NIKDY se nesmí dostat do Gitu.
config.py
.env

# --- Virtuální prostředí ---
# Nainstalované knihovny se do Gitu nedávají, kdokoliv si je obnoví
# z requirements.txt příkazem: pip install -r requirements.txt
.venv/
venv/

# --- Smetí, které vyrábí Python sám ---
__pycache__/
*.pyc

# --- Smetí, které vyrábí Windows / editor ---
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- Databáze (data, ne kód) ---
# asistent.db vzniká za běhu a plní se měřeními. Do Gitu nepatří:
# je to lokální datový soubor, každý stroj si ho vytvoří sám.
asistent.db

# --- Osobní studijní poznámky ---
# Zápisky z učení jsou soukromé, do veřejného repozitáře nepatří.
# Soubory zůstávají na disku, jen je Git přestane sledovat.
poznamky/

# --- Vstupní soubory od uživatele ---
# Odkládací složka pro podklady (screenshoty, exporty, dokumenty).
# Můžou obsahovat osobní údaje -> do repozitáře nepatří.
inputs/

# --- Pracovni vetve Claude Code ---
# .claude/worktrees jsou docasne pracovni kopie repozitare.
# Samy o sobe jsou git repozitare, do naseho repozitare nepatri.
.claude/worktrees/
